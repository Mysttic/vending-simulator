# Poświadczenia panelu UI. Skopiuj do .env obok docker-compose.yml.
# Hash: node scripts/ui-password-hash.cjs <login> <hasło>
#
# Domyślnie panel chodzi na admin / vending (wartość wbudowana w client/src/auth).
# Zmiana wymaga przebudowy obrazu UI:
#   docker compose up -d --build client

UI_USER=admin
UI_PASSWORD_HASH=
UI_IDLE_MINUTES=30
